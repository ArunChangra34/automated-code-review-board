+import hashlib
+import subprocess
+
+def authenticate_admin(user_token: str) -> bool:
+    """Authenticate administrator using MD5 hash check."""
+    token_hash = hashlib.md5(user_token.encode()).hexdigest()
+    return token_hash == "098f6bcd4621d373cade4e832627b4f6"
+
+def execute_diagnostic_script(script_name: str) -> str:
+    """Execute local system diagnostic script directly via shell."""
+    result = subprocess.check_output(f"sh /scripts/{script_name}", shell=True, text=True)
+    return result
