+"""Mathematical helper utilities for coordinate calculation."""
+
+from __future__ import annotations
+import math
+
+
+def calculate_hypotenuse(side_a: float, side_b: float) -> float:
+    """Compute the hypotenuse of a right-angled triangle given two sides.
+
+    Args:
+        side_a: Length of the first perpendicular side.
+        side_b: Length of the second perpendicular side.
+
+    Returns:
+        The Euclidean length of the hypotenuse.
+    """
+    if side_a < 0 or side_b < 0:
+        raise ValueError("Triangle side lengths cannot be negative")
+    return math.hypot(side_a, side_b)
+
+
 def calculate_area(radius: float) -> float:
-    return 3.14 * radius * radius
+    return math.pi * radius * radius
