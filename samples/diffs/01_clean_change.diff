+"""Unit tests for math utilities."""
+
+import pytest
+from src.math_utils import calculate_hypotenuse, calculate_area
+
+
+def test_calculate_hypotenuse_valid() -> None:
+    """Verify hypotenuse for Pythagorean triple."""
+    assert calculate_hypotenuse(3.0, 4.0) == 5.0
+
+
+def test_calculate_hypotenuse_negative_raises() -> None:
+    """Ensure negative sides raise ValueError."""
+    with pytest.raises(ValueError):
+        calculate_hypotenuse(-1.0, 4.0)
+
+
+def test_calculate_area() -> None:
+    """Verify circle area."""
+    assert calculate_area(1.0) > 3.14
