# Execution Mode: offline (deterministic, no API key) or llm (Semantic Kernel model augmented)
CRB_MODE=offline

# Logging
CRB_LOG_LEVEL=INFO

# Agent Execution & Timeouts
CRB_AGENT_TIMEOUT_SECONDS=60
CRB_SIMULATE_FAILURE=

# Model Service Configuration (Semantic Kernel - optional, needed only in llm mode)
CRB_LLM_PROVIDER=openai
CRB_LLM_MODEL_ID=gpt-4o
CRB_LLM_API_KEY=
CRB_LLM_ENDPOINT=

# Analysis Thresholds
CRB_SEVERITY_POLICY_PATH=config/severity_policy.yaml
CRB_ENTROPY_THRESHOLD=4.3
CRB_MAX_LINE_LENGTH=100
CRB_MAX_FUNCTION_LINES=60
CRB_MAX_CYCLOMATIC_COMPLEXITY=10
